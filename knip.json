{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "scripts/**/*.{ts,cjs}",
    "plugins/**/index.ts",
    "plugins/**/steps/*.ts",
    "e2e/**/*.spec.ts",
    "services/mapping-agent/src/index.ts"
  ],
  "project": ["**/*.{ts,tsx}", "!lib/next-boilerplate/**", "!tax-ui/**"],
  "ignore": [
    "lib/next-boilerplate/**",
    "lib/kernel/**"
  ],
  "ignoreDependencies": []
}
