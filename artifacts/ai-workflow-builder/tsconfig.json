{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "src/app/api/**",
    "src/app/layout.tsx",
    "src/app/workflows/*/layout.tsx",
    "src/features/agent-lab/**",
    "src/features/assistant/runtime/**",
    "src/features/worksheets/legacy/**",
    "src/platform/db/**",
    "src/platform/auth/**",
    "src/shared/workflow-engine/runtime/steps/database-query.ts",
    "src/shared/workflow-engine/runtime/workflow-logging.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": []
}
