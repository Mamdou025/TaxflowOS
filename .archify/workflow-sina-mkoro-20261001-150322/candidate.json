  "cards": [
    {
      "dot": "cyan",
      "title": "Who owns the work?",
      "items": [
        "Sina owns native workflows, calculations, sources and retrieval.",
        "Mkoro receives a target, objective, expected output and why a platform tool cannot do the step.",
        "Local paths still need an explicit source import. The handoff is not an OS or network sandbox."
      ]
    },
    {
      "dot": "rose",
      "title": "Admission and permission",
      "items": [
        "Admission checks a saved workspace chat and the actor's own online, compatible, idle computer.",
        "Tool decisions are offered allow-once or reject-once choices. Silence leaves the request pending.",
        "A saved per-computer setting lets the server choose allow-once during polls. No permanent grant."
      ]
    },
    {
      "dot": "amber",
      "title": "Stop and uncertain outcomes",
      "items": [
        "Stop removes an undelivered job or queues cancellation for a running turn. It cannot undo prior effects.",
        "Commands are claimed once; an interrupted response is not permission to replay work.",
        "Goose end_turn means its turn ended. Sina treats text as reported evidence, not proof of platform success."
      ]
    },
    {
      "dot": "violet",
      "title": "Optional desktop view",
      "items": [
        "Opening an authorized active task's viewer renews a 10-second screen lease; Windows capture is view-only.",
        "Latest bounded JPEG lives in API memory and expires. No frames enter durable events or model context.",
        "See docs/mkoro-connection.md and artifacts/api-server/src/lib/mkoro/screens.ts for preview limits."
      ]
    },
    {
      "dot": "slate",
      "title": "Snapshot and limits",
      "items": [
        "Inspected implementation at 444d6e0 (1 October 2026); source passports pin the complete commit.",
        "Worker HTTP uses /api/mkoro-worker; Goose runs locally through ACP. No platform credentials are handed off.",
        "This map is source-backed documentation. It does not certify a live Goose installation, provider or external result."
      ]
    }
  ]
