  "cards": [
    {
      "dot": "cyan",
      "title": "Start in Chat",
      "items": [
        "Chat, Workflows, Sources and Connections share one browser workspace.",
        "Browser previews run locally. A completed preview is separate from approval and server saving."
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared code ownership",
      "items": [
        "workflow-core owns commands and graph rules; workflow-contracts owns persisted shapes.",
        "workflow-executors supplies deterministic tools to browser and server adapters.",
        "These are imported libraries, not additional deployed services."
      ]
    },
    {
      "dot": "violet",
      "title": "AI and source adapters",
      "items": [
        "Sina uses a configured gateway; MicroSina uses a pinned Foundry agent.",
        "Ingestion requires an embedding provider; OCR is conditional.",
        "Source connectors acquire data before a workflow replays its saved inputs."
      ]
    },
    {
      "dot": "rose",
      "title": "Authority and computer access",
      "items": [
        "The server derives the actor from the session and checks current workspace membership.",
        "Mkoro uses a separate revocable worker token and polls outbound for tasks and decisions.",
        "Goose runs with the local computer's permissions; task admission is not an OS sandbox."
      ]
    },
    {
      "dot": "amber",
      "title": "What this map establishes",
      "items": [
        "Source snapshot: 444d6e0 (1 October 2026). SRC opens local file references.",
        "This is a code-backed runtime overview, not a live deployment or provider health check.",
        "Workers are separate responsibilities started by the API; deployment topology may differ."
      ]
    }
  ]
