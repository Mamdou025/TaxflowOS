# ─────────────────────────────────────────────────────────────────────────────
# Environment variables template.
#
# LOCAL: copy this file to ".env.local" and fill in real values.
#        cp .env.example .env.local
#        Restart the dev server after editing (env is read at boot).
#
# REPLIT: do NOT create this file there — add each key in the Secrets panel
#         (Tools -> Secrets). Next.js reads them from process.env the same way.
#
# NEVER put real keys in this file — it is committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / Chat agent ──────────────────────────────────────────────────────────

# OpenAI API key (https://platform.openai.com/api-keys).
# Powers the chat-workspace agent. Read automatically by the OpenAI SDK.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel AI Gateway key — unlocks every provider/model at vercel.com/ai-gateway/models.
# The Agent Lab routes any "provider/model" id (contains a "/") through this key.
AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which OpenAI model the chat agent uses (default: gpt-4o if unset).
# Any tool-calling-capable model works, e.g. gpt-4o, gpt-4o-mini, gpt-4.1.
OPENAI_CHAT_MODEL=gpt-4o

# Assistant model tiering (Sina router). Leave defaults unless you know you need them.
ASSISTANT_MODEL_DEEP=
ASSISTANT_MODEL_FAST=
ASSISTANT_MODEL_TIERING=on

# ── Database (saved chats + document RAG) ────────────────────────────────────

# Postgres/Supabase connection string.
# Supabase: use the pooler URL (port 6543) for serverless.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Web search ───────────────────────────────────────────────────────────────

# Firecrawl API key (https://firecrawl.dev) — powers Sina web search.
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
